<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.3.0.6</Version>
    <AssemblyVersion>0.3.0.6</AssemblyVersion>
    <FileVersion>0.3.0.6</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Jellyfin.Plugin.RetroTv</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.RetroTv</AssemblyName>
    <Copyright>Copyright (c) 2026 Michael DeCato</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <Description>Retro TV — the Internet Archive as a retro-video library and live channels inside Jellyfin.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin 12.4 (server on Dayz). Pin exactly: the plugin ABI is tied to the server version. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Guide\guidePage.html" />
    <EmbeddedResource Include="Guide\Themes\builtin\*.json" />
    <EmbeddedResource Include="Guide\Themes\Branding\*.css" />
    <EmbeddedResource Include="Guide\Channels\lineup.json" />
    <EmbeddedResource Include="Guide\Channels\pools-seed.json" />
    <EmbeddedResource Include="Guide\Channels\breaks-pool.json" />
    <EmbeddedResource Include="Assets\folder.jpg" />
    <!-- meta.json + icon ship next to the DLL inside the release zip (see build.sh). -->
    <None Include="meta.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\repo\assets\icon.webp" Link="icon.webp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
